# DreamDEX V3 profit-maker — environment template.
# Copy to .env and fill in secrets. NEVER commit the real .env.
# Defaults shown match config.py; omit a line to use its default.

# ── Network / wallet ─────────────────────────────────────────────
DREAMDEX_ENV=mainnet                 # mainnet | testnet
MAINNET_PRIVATE_KEY=0x...            # key for the registered V3 wallet (mainnet)
TESTNET_PRIVATE_KEY=0x...            # key for testnet runs
WALLET_ADDRESS=0xD84fE2a2220f0269e3d88dab908ADceb2d691E76   # must match the key above

# ── Capital / reserve (rules: $150 start, no top-ups) ────────────
RESERVE_USDSO=20                     # USDso held back (gas + PnL cushion)

# ── Two-sided maker tunables ─────────────────────────────────────
MAKER_LEG_USD=65                     # USDso notional per resting leg
MAKER_MARGIN_TICKS=1                 # SELL >= avg_cost + this (no realized loss)
MAKER_MAX_INV_USD=90                 # base-inventory cap for top pair (SOMI); WBTC scales to ~$22
MAKER_POLL_S=8                       # fill-poll / reconcile interval (s)
MAKER_DRIFT_TICKS=2                  # touch drift that triggers a re-quote
MAKER_STOP_LOSS_PCT=0.10             # cut a position if mid falls 10% below avg cost (0 disables)
MAKER_STOP_MAX_SLIP_PCT=0.03         # don't sell below cost*(1-stop-slip); defer if book gapped lower (anti-whipsaw)
MAKER_STOP_COOLDOWN_S=900            # pause re-buying that pair for 15m after a stop fires
# Pairs + allocation are set in config.py (SOMI 80% / WBTC 20%).

# ── Gas (50 SOMI given, no refills — convert own USDso for more) ──
GAS_RESERVE_SOMI=5                   # floor before a forced refuel
GAS_REFUEL_USDSO=5                   # USDso -> SOMI per refuel (from working capital)

# ── Liveness (>24h idle = DQ) ────────────────────────────────────
LIVENESS_MAX_IDLE_S=64800            # force activity before this (18h safety margin)
MIN_CAPITAL_STOP=100                 # auto-stop + flatten if total value drops below this

# ── Gemini strategist (Vertex AI via ADC) ────────────────────────
STRATEGIST_ENABLED=true
GEMINI_MODEL=gemini-2.5-pro
STRATEGIST_INTERVAL_S=480            # ~8 min between LLM calls
GOOGLE_CLOUD_PROJECT=project-...     # GCP project with Vertex AI enabled + aiplatform.user
# These two are also set in docker-compose.yml; ADC file is mounted there as /app/adc.json:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=us-central1
# Host setup: gcloud auth application-default login  (no gcloud needed at runtime)

# ── Leaderboard (volume + rank source) ───────────────────────────
LEADERBOARD_URL=https://dreamdex-leaderboard-new.vercel.app/api/leaderboard

# ── Telegram monitor (dreamdex-monitor container) ────────────────
TELEGRAM_BOT_TOKEN=                  # from @BotFather (blank → monitor prints to stdout)
TELEGRAM_CHAT_ID=                    # your chat id (message the bot once, then @userinfobot)
MONITOR_SUMMARY_S=600                # summary card cadence (s)
MONITOR_PREVIEW_S=7200               # market-preview cadence (s) — 2h
MONITOR_POLL_S=90                    # event-check interval (s)
MONITOR_GAS_ALERT_SOMI=8             # low-gas alert threshold

# ── Storage ──────────────────────────────────────────────────────
AGENT_DB_PATH=/app/data/agent.db     # sqlite (in-container default; mounted volume)
