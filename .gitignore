# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Python (also covered in backend/.gitignore)
__pycache__/
*.pyc
.venv/
venv/

# Control API runtime state (engine.json, audit.log, per-run logs, venv)
backend/control/state/

# Arduino build artifacts
build/
*.bin
*.elf

# Playwright MCP transient artifacts
.playwright-mcp/

# Local auth screenshots
dreamdex-docs-auth.png

# Bot-kit fix workspace (filed upstream as somnia-chain/dreamdex-bot-kit issue #7 / PR #8)
kit-fix/
